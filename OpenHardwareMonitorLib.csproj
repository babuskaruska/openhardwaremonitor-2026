<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sensor engine. Deliberately free of any UI dependency so it can be
    consumed headlessly and exercised by a test harness.

    EnableDefaultItems is off because this project shares its directory with
    OpenHardwareMonitor.csproj; default globbing would pull the GUI sources
    (and its .resx files) into this assembly.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenHardwareMonitorLib</AssemblyName>
    <RootNamespace>OpenHardwareMonitor</RootNamespace>
    <AssemblyTitle>Open Hardware Monitor Library</AssemblyTitle>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Hardware\**\*.cs" />
    <Compile Include="Collections\**\*.cs" />
    <Compile Include="Properties\AssemblyAttributes.Lib.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI consumer APIs (SMBIOS.cs, HDD\WindowsSmart.cs). Note this is the
         consumer side only; System.Management.Instrumentation (the provider
         side, used by the old WMI\ folder) has no .NET 10 counterpart. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- Heatmaster / T-Balancer fan controllers speak over a serial port. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODO(Phase 2): both of these are removed when WinRing0 is dropped. -->
    <EmbeddedResource Include="Hardware\WinRing0.sys" />
    <EmbeddedResource Include="Hardware\WinRing0x64.sys" />
  </ItemGroup>

</Project>
