<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored TreeViewAdv. Kept in-tree because there is no maintained NuGet
    package for it; ported rather than replaced.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Aga.Controls</AssemblyName>
    <RootNamespace>Aga.Controls</RootNamespace>
    <AssemblyTitle>Aga.Controls</AssemblyTitle>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO1000 is a .NET 10 analyser asking for DesignerSerializationVisibility
         on every non-trivial property. This control is used from code, not from
         the WinForms designer, so the guidance does not apply. -->
    <NoWarn>$(NoWarn);CS0618;CS0612;SYSLIB0003;SYSLIB0051;WFO1000;WFO5001</NoWarn>
    <EnableWindowsFormsAnalyzers>false</EnableWindowsFormsAnalyzers>
  </PropertyGroup>

</Project>
