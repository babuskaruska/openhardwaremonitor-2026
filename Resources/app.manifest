<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          highestAvailable: administrators get an elevated process, standard
          users run normally. Elevation is only needed for the Deep tier
          (a low-level backend such as PawnIO), SATA SMART pass-through, and
          registering the elevated logon task. Everything else - including
          NVMe health, GPU and processor load/clocks - works without it.
        -->
        <requestedExecutionLevel level="highestAvailable" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share this identifier. The Vista, 7, 8
           and 8.1 entries were removed; .NET 10 does not run on them. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- DPI awareness is intentionally NOT declared here. It is set with
           Application.SetHighDpiMode(PerMonitorV2) in Program.Main, which is
           what .NET WinForms expects; declaring it in both places conflicts. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
