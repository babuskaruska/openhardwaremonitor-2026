<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop application.

    EnableDefaultItems is off because this project shares its directory with
    OpenHardwareMonitorLib.csproj; default globbing would pull the whole
    sensor engine into this assembly as well.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenHardwareMonitor</AssemblyName>
    <RootNamespace>OpenHardwareMonitor</RootNamespace>
    <AssemblyTitle>Open Hardware Monitor</AssemblyTitle>
    <StartupObject>OpenHardwareMonitor.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>Resources\app.manifest</ApplicationManifest>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- See Aga.Controls.csproj: designer-serialization guidance does not
         apply to controls driven entirely from code. -->
    <NoWarn>$(NoWarn);WFO1000;WFO5001;WFO5002;WFO5003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="GUI\**\*.cs" />
    <Compile Include="Utilities\**\*.cs" />
    <Compile Include="Properties\AssemblyAttributes.App.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GUI\**\*.resx" />
    <EmbeddedResource Include="Resources\*.png" />
    <EmbeddedResource Include="Resources\smallicon.ico" />
    <EmbeddedResource Include="Resources\Web\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\app.manifest" />
    <None Include="Resources\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="OpenHardwareMonitorLib.csproj" />
    <ProjectReference Include="External\Aga.Controls\Aga.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces ~50k lines of vendored OxyPlot sources. -->
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.2.0" />
  </ItemGroup>

  <Target Name="CopyLicenses" AfterTargets="Build">
    <ItemGroup>
      <LicenseFiles Include="$(ProjectDir)Licenses\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LicenseFiles)" DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLicensesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishLicenseFiles Include="$(ProjectDir)Licenses\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishLicenseFiles)" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
