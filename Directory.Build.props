<Project>

  <!--
    Shared build configuration for all projects in this repository.

    NOTE ON OUTPUT PATHS: OpenHardwareMonitor.csproj and OpenHardwareMonitorLib.csproj
    both live in the repository root. SDK-style projects default to obj\ and bin\
    relative to the project file, so without the overrides below the two projects
    would share an intermediate directory and corrupt each other's build state.
    BaseIntermediateOutputPath must be set here (not in the .csproj body) because
    NuGet restore reads it before the project body is evaluated.
  -->

  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;ARM64</Platforms>

    <!--
      Nullable is opt-in per file via '#nullable enable' rather than on by default.
      Switching it on repo-wide across ~28k lines of 2009-era code emits thousands
      of warnings at once, which buries genuine diagnostics. New and rewritten files
      enable it explicitly; the default flips once the legacy surface is migrated.
    -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Assembly metadata is generated from these properties; the hand-written
         Properties\AssemblyInfo.cs files were removed to avoid CS0579 duplicates. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.11.0</Version>
    <!-- Release builds from a v* tag set InformationalVersion (see build.yml). -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.11.0-dev</InformationalVersion>
    <Product>Open Hardware Monitor</Product>
    <Company>Open Hardware Monitor</Company>
    <Copyright>Copyright © 2009-2020 Michael Möller, © 2020-2026 contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- The Windows-only surface is intentional; this is a Windows hardware monitor. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
