<Project>
  <!--
    The distributable build: one executable with the .NET runtime inside it.

    A framework-dependent build only starts if the .NET 10 Desktop Runtime is
    installed system-wide. Otherwise the apphost shows "You must install or
    update .NET" and exits with 0x80008096. Self-contained removes that
    prerequisite, which also matters for Run On Windows Startup, because a
    logon task cannot answer an install prompt.

    Trimming stays off: WinForms, the Task Scheduler COM interop and the
    Reflection.Emit based P/Invoke delegate factory are not trim-safe.

    dotnet publish OpenHardwareMonitor.csproj -c Release -p:PublishProfile=SelfContained-win-x64
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Precompiled code: the window opens without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
