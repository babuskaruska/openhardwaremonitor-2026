<Project>
  <!--
    EXPERIMENTAL. Windows on ARM build, produced by CI but not tested on ARM64
    hardware. CPUID-based processor detection does not exist on ARM, so
    processor sensors are limited to what the operating system reports.

    dotnet publish OpenHardwareMonitor.csproj -c Release -p:PublishProfile=SelfContained-win-arm64
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Precompiled code: the window opens without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\artifacts\publish\win-arm64\</PublishDir>
  </PropertyGroup>
</Project>
